<%- include('partials/header') %>

    <main>
        <h1>Service Project Categories</h1>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-category">Add New Category</a></p>
            <% } %>

                <% if (categories && categories.length> 0) { %>
                    <ul>
                        <% categories.forEach(category=> { %>
                            <li>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>
                                <% if (user && user.role_name==='admin' ) { %>
                                    - <a href="/edit-category/<%= category.category_id %>">Edit</a>
                                    <% } %>
                            </li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p>No categories are currently available.</p>
                        <% } %>
    </main>

    <%- include('partials/footer') %>