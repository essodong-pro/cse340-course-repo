<%- include('partials/header') %>
    <main>
        <h1>
            <%= project.title %>
        </h1>
        <p><strong>Date:</strong>
            <%= project.date.toDateString() %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a></p>

        <h3>Categories:</h3>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>

        <!-- Volunteer Section -->
        <% if (locals.user) { %>
            <div class="volunteer-section"
                style="margin: 20px 0; padding: 15px; background: #f9f9f9; border-radius: 5px;">
                <% if (isVolunteering) { %>
                    <p>You are volunteering for this project. <a href="/project/<%= project.project_id %>/unvolunteer"
                            class="button" style="margin-left: 10px; color: red;">Remove Volunteer Status</a></p>
                    <% } else { %>
                        <p><a href="/project/<%= project.project_id %>/volunteer" class="button">Volunteer for this
                                Project</a></p>
                        <% } %>
            </div>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <p>
                        <a href="/edit-project/<%= project.project_id %>">Edit Project</a> |
                        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                    </p>
                    <% } %>
    </main>
    <%- include('partials/footer') %>